{% extends 'base.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block body %}
<div class="mb-4">
    <h1 class="section-title">Nos catégories</h1>
    <p class="text-muted mt-2">
        Sélectionnez une catégorie pour afficher les produits associés.
    </p>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    {% for category in categories %}
        <div class="col">
            <div class="card product-card h-100 text-center">
                <div class="card-body p-4">
                    <div class="category-icon mb-3">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>

                    <h4 class="fw-bold" style="color: var(--navy);">{{ category.name }}</h4>

                    <p class="text-muted">
                        {{ category.description }}
                    </p>

                    <span class="badge bg-primary mb-3">
                        {{ category.products|length }} produit(s)
                    </span>

                    <a href="{{ path('app_category_products', {id: category.id}) }}" class="btn btn-primary w-100">
                        Voir la catégorie
                    </a>
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info">Aucune catégorie trouvée.</div>
    {% endfor %}
</div>
{% endblock %}
