<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}RedShop{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        :root {
            --main-red: #cc1a1a;
            --dark-red: #991010;
            --navy: #0d1b3e;
            --dark-navy: #081229;
            --gold: #c9a84c;
            --gold-dark: #a8872f;
            --light-bg: #f4f5f8;
            --card-bg: #ffffff;
        }

        body {
            background: var(--light-bg);
            color: #1a1a2e;
            font-family: Arial, Helvetica, sans-serif;
        }

        .top-bar {
            background: var(--dark-navy);
            color: #d4d8e8;
            font-size: 0.9rem;
            padding: 8px 0;
            border-bottom: 2px solid var(--gold);
        }

        .main-navbar {
            background: linear-gradient(90deg, var(--dark-navy), var(--navy));
            border-bottom: 4px solid var(--main-red);
        }

        .navbar-brand {
            font-size: 1.6rem;
            font-weight: bold;
            color: white !important;
            letter-spacing: 1px;
        }

        .navbar-brand span {
            color: var(--gold);
        }

        .main-navbar .nav-link {
            color: #d4d8e8 !important;
            font-weight: 500;
            margin-left: 12px;
            transition: color 0.2s;
        }

        .main-navbar .nav-link:hover {
            color: var(--gold) !important;
        }

        .user-box {
            background: var(--main-red);
            color: white;
            padding: 7px 14px;
            border-radius: 30px;
            font-size: 0.9rem;
            border: 1px solid var(--gold);
        }

        .section-title {
            font-weight: bold;
            color: var(--navy);
            border-left: 6px solid var(--main-red);
            padding-left: 14px;
        }

        .page-card {
            background: var(--card-bg);
            border: none;
            border-radius: 8px;
            box-shadow: 0 8px 25px rgba(13, 27, 62, 0.12);
        }

        .product-card {
            background: white;
            border: none;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 8px 22px rgba(13, 27, 62, 0.12);
            transition: 0.2s;
            border-top: 5px solid var(--main-red);
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 14px 30px rgba(13, 27, 62, 0.20);
            border-top-color: var(--gold);
        }

        .category-icon {
            width: 65px;
            height: 65px;
            border-radius: 50%;
            background: var(--navy);
            color: var(--gold);
            display: flex;
            justify-content: center;
            align-items: center;
            margin: auto;
            font-size: 1.8rem;
        }

        /* Buttons */
        .btn-primary {
            background: var(--main-red);
            border-color: var(--main-red);
            color: white;
        }

        .btn-primary:hover {
            background: var(--dark-red);
            border-color: var(--dark-red);
            color: white;
        }

        .btn-outline-primary {
            color: var(--main-red);
            border-color: var(--main-red);
        }

        .btn-outline-primary:hover {
            background: var(--main-red);
            border-color: var(--main-red);
            color: white;
        }

        .btn-success {
            background: var(--navy);
            border-color: var(--navy);
            color: white;
        }

        .btn-success:hover {
            background: var(--main-red);
            border-color: var(--main-red);
        }

        .btn-gold {
            background: var(--gold);
            border-color: var(--gold);
            color: var(--navy);
            font-weight: 700;
        }

        .btn-gold:hover {
            background: var(--gold-dark);
            border-color: var(--gold-dark);
            color: white;
        }

        /* Badges & text overrides */
        .badge.bg-primary {
            background: var(--navy) !important;
            color: var(--gold) !important;
            border: 1px solid var(--gold);
        }

        .text-success {
            color: var(--main-red) !important;
        }

        .text-danger {
            color: var(--main-red) !important;
        }

        /* Card header overrides */
        .card-header.bg-primary {
            background: linear-gradient(90deg, var(--dark-navy), var(--navy)) !important;
            border-bottom: 3px solid var(--gold) !important;
        }

        .card-header.bg-success {
            background: linear-gradient(90deg, var(--dark-navy), var(--navy)) !important;
            border-bottom: 3px solid var(--gold) !important;
        }

        /* Hero gradient panels */
        .hero-panel {
            background: linear-gradient(135deg, var(--dark-navy), var(--main-red));
        }

        footer {
            background: var(--dark-navy);
            border-top: 4px solid var(--gold);
        }

        footer a {
            color: var(--gold);
        }

        /* Gold accent border for summary cards */
        .gold-border-top {
            border-top: 5px solid var(--gold) !important;
        }

        /* Alert overrides */
        .alert-success {
            background: #e8f0fc;
            border-color: var(--navy);
            color: var(--navy);
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body>

<div class="top-bar">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <i class="fa-solid fa-truck-fast me-2" style="color: var(--gold);"></i>
            Livraison rapide et produits de qualité
        </div>

        <div>
            {% if app.user %}
                <span class="user-box">
                    Bienvenue, {{ app.user.fullName|default(app.user.email) }}
                </span>
            {% else %}
                <span>Connectez-vous pour gérer votre profil</span>
            {% endif %}
        </div>
    </div>
</div>

<nav class="navbar navbar-expand-lg main-navbar py-3">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">
            <i class="fa-solid fa-bag-shopping me-2" style="color: var(--gold);"></i>Red<span>Shop</span>
        </a>

        <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainMenu">
            <ul class="navbar-nav ms-auto align-items-lg-center">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_home') }}">Accueil</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_category_browse') }}">Catégories</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_product_list') }}">Produits</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_cart') }}">
                        <i class="fa-solid fa-cart-shopping me-1"></i> Panier
                    </a>
                </li>

                {% if app.user %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_profil') }}">Profil</a>
                    </li>

                    <li class="nav-item">
                        <a class="btn btn-primary ms-lg-3" href="{{ path('app_logout') }}">
                            Déconnexion
                        </a>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_login') }}">Connexion</a>
                    </li>

                    <li class="nav-item">
                        <a class="btn btn-primary ms-lg-3" href="{{ path('app_register') }}">
                            Inscription
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

<div class="container mt-3">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} alert-dismissible fade show shadow-sm border-0" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}
</div>

<main class="container my-5">
    {% block body %}{% endblock %}
</main>

<footer class="text-white mt-5 py-4">
    <div class="container text-center">
        <p class="mb-1 fw-bold" style="color: var(--gold);">RedShop</p>
        <p class="mb-0 text-light">&copy; 2026 Tous droits réservés.</p>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
