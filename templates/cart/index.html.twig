{% extends 'base.html.twig' %}

{% block title %}Panier{% endblock %}

{% block body %}
<div class="mb-4">
    <h1 class="section-title">Mon panier</h1>
    <p class="text-muted mt-2">Consultez les produits ajoutés à votre panier.</p>
</div>

{% if items is empty %}
    <div class="page-card p-5 text-center">
        <i class="fa-solid fa-cart-shopping mb-3" style="font-size: 4rem; color: var(--main-red);"></i>
        <h3 class="fw-bold" style="color: var(--navy);">Votre panier est vide</h3>
        <p class="text-muted">Ajoutez des produits pour commencer vos achats.</p>
        <a href="{{ path('app_product_list') }}" class="btn btn-primary">
            Voir les produits
        </a>
    </div>
{% else %}
    <div class="row">
        <div class="col-lg-8">
            <div class="page-card p-4">
                {% for item in items %}
                    <div class="d-flex justify-content-between align-items-center border-bottom py-3">
                        <div>
                            <h5 class="fw-bold mb-1" style="color: var(--navy);">{{ item.product.name }}</h5>
                            <p class="text-muted mb-0">
                                Prix : {{ item.product.price }} DH |
                                Quantité : {{ item.quantity }}
                            </p>
                        </div>

                        <div class="text-end">
                            <p class="fw-bold mb-2" style="color: var(--main-red);">
                                {{ item.subtotal }} DH
                            </p>

                            <form action="{{ path('app_cart_remove', {id: item.product.id}) }}" method="POST">
                                <button class="btn btn-sm btn-outline-danger">
                                    Supprimer
                                </button>
                            </form>
                        </div>
                    </div>
                {% endfor %}

                <form action="{{ path('app_cart_clear') }}" method="POST" class="mt-4">
                    <button class="btn btn-outline-primary">
                        Vider le panier
                    </button>
                </form>
            </div>
        </div>

        <div class="col-lg-4 mt-4 mt-lg-0">
            <div class="page-card p-4 gold-border-top">
                <h4 class="fw-bold mb-4" style="color: var(--navy);">Résumé</h4>

                <div class="d-flex justify-content-between mb-4">
                    <span>Total :</span>
                    <strong style="color: var(--main-red); font-size: 1.5rem;">{{ total }} DH</strong>
                </div>

                <button class="btn btn-gold btn-lg w-100">
                    Commander
                </button>
            </div>
        </div>
    </div>
{% endif %}
{% endblock %}
