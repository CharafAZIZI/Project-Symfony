{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow" style="border: none; border-radius: 10px; overflow: hidden;">
                <div class="card-header text-white text-center py-3" style="background: linear-gradient(90deg, var(--dark-navy), var(--navy)); border-bottom: 3px solid var(--gold);">
                    <h3><i class="fas fa-sign-in-alt me-2" style="color: var(--gold);"></i>Connexion</h3>
                </div>
                <div class="card-body p-4">
                    
                    {% if error %}
                        <div class="alert alert-danger alert-dismissible fade show">
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endif %}

                    <form method="post">
                        {% if last_username %}
                            <input type="hidden" name="_security_last_username" value="{{ last_username }}">
                        {% endif %}
                        
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <div class="mb-3">
                            <label for="input_email" class="form-label fw-bold" style="color: var(--navy);">Email</label>
                            <input type="email" 
                                   value="{{ last_username }}" 
                                   name="email" 
                                   id="input_email" 
                                   class="form-control" 
                                   style="border-color: var(--navy);"
                                   autocomplete="email" 
                                   required autofocus>
                        </div>

                        <div class="mb-3">
                            <label for="input_password" class="form-label fw-bold" style="color: var(--navy);">Mot de passe</label>
                            <input type="password" 
                                   name="password" 
                                   id="input_password" 
                                   class="form-control"
                                   style="border-color: var(--navy);"
                                   autocomplete="current-password" 
                                   required>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 btn-lg">
                            <i class="fas fa-sign-in-alt me-2"></i>Se connecter
                        </button>
                    </form>

                    <hr class="my-4">
                    <div class="text-center">
                        <a href="{{ path('app_register') }}" class="btn btn-link" style="color: var(--main-red);">Pas de compte ? Inscrivez-vous</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
